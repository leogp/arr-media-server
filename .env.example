# Copy this file to .env and adjust the values: `cp .env.example .env`

# User and group the LinuxServer containers run as (`id -u` / `id -g` on Linux).
# On Windows (Docker Desktop) these have no effect on file ownership, but must still be set.
PUID=1000
PGID=1000
TZ=America/Argentina/Buenos_Aires

# Files are created group-writable (664/775) so every container sharing PGID can manage them.
UMASK=002

# Host folder that contains downloads/, movies/ and tvshows/. It is mounted as /data in every container.
# Linux:
DATA_ROOT=/media
# Windows (Docker Desktop): prefer a path inside the WSL2 filesystem, e.g. /home/<user>/media,
# so hardlinks work. A Windows drive also works, but hardlinks are not guaranteed there:
# DATA_ROOT=D:/media

# Compose files to load. Leave unset to use only compose.yaml.
# Add GPU overlays here (see README "Hardware transcoding"). The separator depends on the OS:
# Linux (separator ":"):
# COMPOSE_FILE=compose.yaml:docker-compose.gpu-vaapi.yml
# Windows (separator ";"):
# COMPOSE_FILE=compose.yaml;docker-compose.gpu-nvidia.yml
